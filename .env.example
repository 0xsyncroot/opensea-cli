# ─── Network ───────────────────────────────────────────────────────────────
# Use a fast, low-latency RPC (private Alchemy/Infura/quicknode beats public).
RPC_URL=https://eth.llamarpc.com
CHAIN_ID=1

# Bundle relays (comma-separated). Post-merge, blocks are built by competing
# builders — blast the bundle to all of them so whichever wins the slot
# includes your tx. Titan + Beaver + rsync currently dominate mainnet.
# All builders honor the priority fee as their "tip" (paid to coinbase).
RELAYS=https://relay.flashbots.net,https://rpc.titanbuilder.xyz,https://rpc.beaverbuild.org,https://rsync-builder.xyz,https://rpc.payload.de,https://api.blocknative.com/v1/auction

# Optional: persistent auth key for Flashbots reputation. Leave blank to
# generate a fresh one each run. NOTE: this is NOT your funds key.
# FLASHBOTS_AUTH_KEY=

# ─── Target contract (BackPunks or any other) ─────────────────────────────
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Solidity function signature of the public mint entry.
# Common patterns:
#   mint(uint256)            → MINT_ARGS=["qty"]
#   publicMint(uint256)      → MINT_ARGS=["qty"]
#   mint(address,uint256)    → MINT_ARGS=["self","qty"]
#   mint()                   → MINT_ARGS=[]
MINT_FUNCTION_SIGNATURE=mint(uint256)

# JSON array. Tokens: "self" → minter address, "qty" → MINT_QUANTITY.
# Numbers as-is, large numbers as strings: ["1000000000000000000"]
MINT_ARGS=["qty"]

MINT_QUANTITY=1

# Price per token in ETH. Total tx value = MINT_PRICE_ETH × MINT_QUANTITY.
MINT_PRICE_ETH=0

# ─── Gas strategy ──────────────────────────────────────────────────────────
# Gas limit per tx. Set generously — Flashbots refunds unused gas.
GAS_LIMIT=300000

# Priority fee (tip) cap in gwei. Flashbots ranks bundles by effective
# priority fee — so this is what you bid to win the slot. Start low (2-3),
# bump only if you keep losing.
MAX_PRIORITY_FEE_GWEI=2

# Hard ceiling on maxFeePerGas. Auto-bumped to baseFee+priority if too low.
MAX_FEE_GWEI=100

# Bundle is resubmitted across this many future blocks (1-block windows).
BLOCKS_TO_TARGET=3

# ─── Timing (optional) ─────────────────────────────────────────────────────
# Auto-fire when mint opens. Use ONE of these (or neither for fire-now):
#
#   MINT_START_TS   — unix timestamp (seconds). Tool sleeps until then, fires.
#   MINT_START_BLOCK— Ethereum block number. Tool polls head, fires when head
#                     reaches START_BLOCK-1, targeting blocks START..START+N-1.
# MINT_START_TS=1746950400
# MINT_START_BLOCK=22500000

# Adaptive priority: pull eth_feeHistory and bid (configurable percentile +
# small premium) instead of fixed MAX_PRIORITY_FEE_GWEI. Min-gas-to-win.
# Format: "<percentile>+<premium_gwei>" — e.g. "75+0.5" = 75th pct + 0.5 gwei.
# Leave blank to use MAX_PRIORITY_FEE_GWEI as a fixed bid.
# ADAPTIVE_PRIORITY=75+0.5
